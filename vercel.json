{

  "functions": { "api/lotto.js": { "maxDuration": 60 } },

  "cleanUrls": true,

  "trailingSlash": false,

  "redirects": [

    { "source": "/", "destination": "https://www.calqio.com/ko", "statusCode": 308 },

    { "source": "/fire", "destination": "https://www.calqio.com/ko/fire", "statusCode": 308 },



    { "source": "/compound", "destination": "https://www.calqio.com/ko/compound", "statusCode": 308 },

    { "source": "/return", "destination": "https://www.calqio.com/ko/return", "statusCode": 308 },

    { "source": "/average-down", "destination": "https://www.calqio.com/ko/average-down", "statusCode": 308 },

    { "source": "/loan", "destination": "https://www.calqio.com/ko/loan", "statusCode": 308 },

    { "source": "/dividend", "destination": "https://www.calqio.com/ko/dividend", "statusCode": 308 },

    { "source": "/target", "destination": "https://www.calqio.com/ko/target", "statusCode": 308 },

    { "source": "/tax", "destination": "https://www.calqio.com/ko/tax", "statusCode": 308 },

    { "source": "/percent", "destination": "https://www.calqio.com/ko/percent", "statusCode": 308 },

    { "source": "/etf-comparison", "destination": "https://www.calqio.com/ko/etf-comparison", "statusCode": 308 },

    { "source": "/concept", "destination": "https://www.calqio.com/ko/concept", "statusCode": 308 },

    { "source": "/simple-vs-compound", "destination": "https://www.calqio.com/ko/simple-vs-compound", "statusCode": 308 },

    { "source": "/ai-investment", "destination": "https://www.calqio.com/ko/ai-investment", "statusCode": 308 },



    {
      "source": "/:path*.html",
      "has": [{ "type": "host", "value": "calqio.com" }],
      "destination": "https://www.calqio.com/:path*",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "calqio.com" }],
      "destination": "https://www.calqio.com/:path*",
      "statusCode": 308
    }

  ],

  "rewrites": [
    { "source": "/fx-rates.json", "destination": "/api/fx-rates" }
  ],
  "crons": [
    { "path": "/api/fx-update", "schedule": "30 2 * * 1-5" }
  ],

  "headers": [

    {

      "source": "/(.*)",

      "headers": [

        { "key": "X-Content-Type-Options", "value": "nosniff" },

        { "key": "Cache-Control", "value": "public, max-age=3600" }

      ]

    }

  ]

}


